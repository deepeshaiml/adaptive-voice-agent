# LiveKit project or self-hosted server
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound SIP is used only for explicitly controlled test numbers.
SIP_OUTBOUND_TRUNK_ID=
SPEAKING_AGENT_ALLOWED_TEST_NUMBERS=
# Keep this stable for a database. A mismatch blocks outbound calling.
SPEAKING_AGENT_SUPPRESSION_KEY=replace-with-at-least-32-random-bytes

# Optional SIP REFER destination, for example +15555550123 or sip:user@host.
SPEAKING_AGENT_TRANSFER_TO=

# Optional runtime overrides
SPEAKING_AGENT_CAMPAIGN=campaigns/neoai_property_owner.json
SPEAKING_AGENT_DATABASE=data/speaking_agent.db
# Optional normalized gateway backed by approved DLD/Property Monitor/listing feeds.
SPEAKING_AGENT_MARKET_DATA_URL=
SPEAKING_AGENT_MARKET_DATA_TOKEN=
SPEAKING_AGENT_MARKET_DATA_TIMEOUT_SECONDS=5
# Controlled demo only: http://127.0.0.1:8765/comparables
# Optional CRM/notification webhook. Receives every connected human call analysis.
SPEAKING_AGENT_LEAD_WORKFLOW_URL=
SPEAKING_AGENT_LEAD_WORKFLOW_TOKEN=
SPEAKING_AGENT_LEAD_WORKFLOW_TIMEOUT_SECONDS=5
# Controlled demo only: http://127.0.0.1:8766/events
# Used only when the campaign enables consented call recording.
SPEAKING_AGENT_RECORDING_DIRECTORY=data/recordings
# One-time only for populated databases created before per-row expiration.
# SPEAKING_AGENT_LEGACY_RETENTION_DAYS=90
